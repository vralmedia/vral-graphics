# Required to expose POST /api/leads. Generate a long random value; never put it in frontend code.
VG_FORM_API_KEY=replace-with-a-long-random-secret
# Exact public site origin, for example https://vralgraphics.com
VG_FORM_ALLOWED_ORIGIN=https://vral-vision-spark.lovable.app
# Same-origin browser relay for POST /api/print-requests and /field login. Defaults to VG_FORM_ALLOWED_ORIGIN.
VG_PUBLIC_ORIGIN=https://vralgraphics.com
# Private /field and /admin sessions. Without these, login stays BLOCKED and is never simulated.
VG_FIELD_SESSION_SECRET=replace-with-a-long-random-secret
VG_FIELD_USERS=[{"username":"mike","password":"replace-me","name":"Mike","role":"rep"},{"username":"anthony","password":"replace-me","name":"Anthony","role":"admin"}]
# Durable JSONL storage location. Keep outside a public/static directory.
LEAD_STORE_PATH=./data/leads.jsonl
# Delivery jobs are durable JSONL events in the same private store; these bound retry work.
VG_DELIVERY_MAX_ATTEMPTS=3
VG_DELIVERY_RETRY_DELAY_MS=250
# Set true only when direct access is blocked and a trusted proxy overwrites X-Forwarded-For.
VG_TRUST_PROXY=false

# Optional generic CRM relay. Without this URL, delivery is explicitly BLOCKED.
VG_CRM_WEBHOOK_URL=
VG_CRM_WEBHOOK_TOKEN=
# Legacy operator-owned email relay; delivery.js uses the safe sandbox/provider path below.
VG_FLYER_EMAIL_WEBHOOK_URL=
VG_FLYER_EMAIL_WEBHOOK_TOKEN=

# Delivery defaults to a local SANDBOX outbox. It never contacts a prospect/customer.
VG_DELIVERY_MODE=sandbox
VG_FLYER_PATH=/Users/seujao/Downloads/PHOTO-2026-08-22-17-28-58.jpg
VG_OUTBOX_DIR=./delivery/outbox
# Optional provider test mode. Only +test@, example.test, example.invalid, test.invalid,
# or localhost recipients are accepted; the submitted lead email is never a destination.
VG_EMAIL_PROVIDER=
VG_EMAIL_FROM=
VG_EMAIL_TEST_TO=mike+test@example.test
# Resend / Postmark / SendGrid credentials, if an authenticated test provider is intentionally enabled.
VG_RESEND_API_KEY=
VG_POSTMARK_SERVER_TOKEN=
VG_SENDGRID_API_KEY=

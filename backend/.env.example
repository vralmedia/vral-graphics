# Required to expose POST /api/leads. Generate a long random value; never put it in frontend code.
VG_FORM_API_KEY=replace-with-a-long-random-secret
# Exact public site origin, for example https://vralgraphics.com
VG_FORM_ALLOWED_ORIGIN=
# Durable JSONL storage location. Keep outside a public/static directory.
LEAD_STORE_PATH=./data/leads.jsonl
# Delivery jobs are durable JSONL events in the same private store; these bound retry work.
VG_DELIVERY_MAX_ATTEMPTS=3
VG_DELIVERY_RETRY_DELAY_MS=250
# Set true only when direct access is blocked and a trusted proxy overwrites X-Forwarded-For.
VG_TRUST_PROXY=false

# Optional generic CRM relay. Without this URL, delivery is explicitly BLOCKED.
VG_CRM_WEBHOOK_URL=
VG_CRM_WEBHOOK_TOKEN=
# Optional real email relay for flyer/lead notifications. Without this URL, delivery is explicitly BLOCKED.
VG_FLYER_EMAIL_WEBHOOK_URL=
VG_FLYER_EMAIL_WEBHOOK_TOKEN=
